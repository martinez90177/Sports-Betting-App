{
  "crons": [
    {
      "path": "/api/refresh-mlb-matchups",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/nfl-allowed.js": {
      "maxDuration": 60
    },
    "api/case.js": {
      "maxDuration": 30
    },
    "api/slip.js": {
      "maxDuration": 30
    },
    "api/nba-allowed.js": {
      "maxDuration": 60
    }
  }
}
